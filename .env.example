# 必填：阿里云百炼（DashScope）API Key，Qwen LLM 与 Embedding 共用
# 获取地址：https://bailian.console.aliyun.com/  ->  API-KEY 管理
DASHSCOPE_API_KEY=sk-your-dashscope-key

# 可选：一键同步代码到魔搭创空间时使用（scripts/sync_studio.py）
# 生成地址：https://modelscope.cn/my/myaccesstoken
MODELSCOPE_API_TOKEN=ms-your-modelscope-token

# 以下为可选覆盖项，留空即使用 config/config.yaml 中的默认值
EV_MODEL=qwen-plus
EV_EMBEDDING_MODEL=text-embedding-v3
EV_LOG_LEVEL=INFO
